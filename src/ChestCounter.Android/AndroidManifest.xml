<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- The floating counter over Fortnite. -->
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
  <!-- Android 10 and older: Fortnite's replays folder can be read directly. -->
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

  <!-- Fortnite: to know whether it is installed and to start it from the counter. -->
  <queries>
    <package android:name="com.epicgames.fortnite" />
  </queries>

  <application android:label="@string/app_name" android:icon="@drawable/ic_launcher" android:allowBackup="true"
               android:requestLegacyExternalStorage="true" android:supportsRtl="true">
    <service android:name="io.github.chestcounter.android.CounterService" android:exported="false"
             android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Counts the chests of the Fortnite matches being played and shows a floating counter over the game." />
    </service>
  </application>
</manifest>
