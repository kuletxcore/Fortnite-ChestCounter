<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tests of the platform-neutral code shared by the Windows exe and the Android app. Runs on any OS: dotnet test. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>ChestCounter.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\lib\FortniteReplayReader\FortniteReplayReader.csproj" />
  </ItemGroup>
  <!-- Same shared files as src/ChestCounter.Android, plus the Android logic that has no Android types. -->
  <ItemGroup>
    <Compile Include="..\..\src\ChestCounter\AppInfo.cs" Link="Shared\AppInfo.cs" />
    <Compile Include="..\..\src\ChestCounter\ChestEstimate.cs" Link="Shared\ChestEstimate.cs" />
    <Compile Include="..\..\src\ChestCounter\ConsoleUi.cs" Link="Shared\ConsoleUi.cs" />
    <Compile Include="..\..\src\ChestCounter\ErrorLog.cs" Link="Shared\ErrorLog.cs" />
    <Compile Include="..\..\src\ChestCounter\GameModes.cs" Link="Shared\GameModes.cs" />
    <Compile Include="..\..\src\ChestCounter\Lang.cs" Link="Shared\Lang.cs" />
    <Compile Include="..\..\src\ChestCounter\Models.cs" Link="Shared\Models.cs" />
    <Compile Include="..\..\src\ChestCounter\OverlayModel.cs" Link="Shared\OverlayModel.cs" />
    <Compile Include="..\..\src\ChestCounter\Profiles.cs" Link="Shared\Profiles.cs" />
    <Compile Include="..\..\src\ChestCounter\ReplayAnalyzer.cs" Link="Shared\ReplayAnalyzer.cs" />
    <Compile Include="..\..\src\ChestCounter\ReportWriter.cs" Link="Shared\ReportWriter.cs" />
    <Compile Include="..\..\src\ChestCounter\Tracker.cs" Link="Shared\Tracker.cs" />
    <Compile Include="..\..\src\ChestCounter\TreasureCatalog.cs" Link="Shared\TreasureCatalog.cs" />
    <Compile Include="..\..\src\ChestCounter\TreasureImages.cs" Link="Shared\TreasureImages.cs" />
    <Compile Include="..\..\src\ChestCounter.Android\CueMatcher.cs" Link="Android\CueMatcher.cs" />
    <Compile Include="..\..\src\ChestCounter.Android\TallyRecord.cs" Link="Android\TallyRecord.cs" />
    <Compile Include="..\..\src\ChestCounter.Android\CounterReset.cs" Link="Android\CounterReset.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\src\ChestCounter\Assets\PirataOne-latin.woff2" LogicalName="PirataOne.woff2" />
    <EmbeddedResource Include="..\..\RELEASE_NOTES.md" LogicalName="ReleaseNotes.md" />
    <EmbeddedResource Include="..\..\content\content.json" LogicalName="content.json" />
    <!-- The file players download, checked as it is in the repository. -->
    <None Include="..\..\content\content.json" Link="content.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
